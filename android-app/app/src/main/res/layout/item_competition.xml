<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/bg_frosted_card"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Tags Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCompCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_circle_icon"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="POWERLIFTING (SBD)"
            android:textColor="@color/color_cyan"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvCompPrize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pool: ₹ 5,00,000"
            android:textColor="@color/color_volt"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Meet Title -->
    <TextView
        android:id="@+id/tvCompTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="National Raw Powerlifting Cup 2026"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Venue & City -->
    <TextView
        android:id="@+id/tvCompVenue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Thyagaraj Sports Complex, New Delhi • Oct 18, 2026"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Action Button -->
    <TextView
        android:id="@+id/btnRegisterComp"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_active_pill"
        android:gravity="center"
        android:text="ENTER SANCTIONED MEET (₹ 1,500)"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
