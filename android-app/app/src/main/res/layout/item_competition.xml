<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gradient_card"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvCompCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Powerlifting (SBD)"
            android:textColor="@color/color_orange"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCompPrize"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="Prize: ₹ 5,00,000"
            android:textColor="@color/color_volt"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCompTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="National Raw Powerlifting Cup 2026"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvCompVenue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Thyagaraj Sports Complex, New Delhi • 2026-10-18"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <Button
        android:id="@+id/btnRegisterComp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="ENTER MEET (₹ 1,500)"
        android:textColor="@color/bg_black"
        android:textStyle="bold"
        android:textSize="12sp"
        android:backgroundTint="@color/color_volt"
        android:layout_marginTop="12dp" />

</LinearLayout>
