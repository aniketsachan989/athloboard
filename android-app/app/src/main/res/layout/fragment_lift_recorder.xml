<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_black"
    android:padding="16dp">

    <!-- Camera Preview Frame -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cameraCard"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_darker"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Camera Viewfinder Placeholder / Surface -->
            <View
                android:id="@+id/cameraPreviewSurface"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#151A24" />

            <!-- Parallel Depth Guideline -->
            <View
                android:id="@+id/guidelineDepth"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/color_volt"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.62" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="◄ PARALLEL SQUAT DEPTH THRESHOLD ►"
                android:textColor="@color/color_volt"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="4dp"
                app:layout_constraintBottom_toTopOf="@id/guidelineDepth"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Timer / Status -->
            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="@color/text_main"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:background="@drawable/bg_volt_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_margin="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <!-- Angle Helper -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90° SIDE VIEW"
                android:textColor="@color/color_cyan"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_margin="14dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Countdown Overlay -->
            <TextView
                android:id="@+id/tvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="@color/color_orange"
                android:textSize="72sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Metadata Inputs Card -->
    <LinearLayout
        android:id="@+id/inputCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg_card"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/cameraCard">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIFT METADATA FOR ADMIN REVIEW"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Spinner
                android:id="@+id/spnLiftType"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/bg_darker"
                android:layout_marginEnd="8dp" />

            <EditText
                android:id="@+id/etClaimedWeight"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Weight (kg)"
                android:inputType="number"
                android:text="265"
                android:textColor="@color/text_main"
                android:textColorHint="@color/text_dim"
                android:background="@color/bg_darker"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Record and Submit Buttons -->
        <Button
            android:id="@+id/btnRecord"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="RECORD LIFT"
            android:textColor="@color/bg_black"
            android:textStyle="bold"
            android:backgroundTint="@color/color_volt"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnSubmitAdmin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="SUBMIT FOR ADMIN VERIFICATION"
            android:textColor="@color/text_main"
            android:textStyle="bold"
            android:backgroundTint="@color/color_orange"
            android:visibility="gone"
            android:layout_marginTop="14dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
