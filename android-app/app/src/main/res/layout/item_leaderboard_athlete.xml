<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_frosted_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Rank Badge Pill -->
    <TextView
        android:id="@+id/tvRankNumber"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="@drawable/bg_circle_icon"
        android:gravity="center"
        android:text="#1"
        android:textColor="@color/color_volt"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Avatar -->
    <ImageView
        android:id="@+id/ivAthleteAvatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_circle_icon"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_user" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAthleteName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kabir Rawat"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAthleteSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Titan Iron Club • 83kg"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Total SBD Metric -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvAthleteTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="640 kg"
            android:textColor="@color/text_main"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Verified SBD"
            android:textColor="@color/color_green"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
